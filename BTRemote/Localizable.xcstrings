    "setup.classic_guide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Bluetooth Classic"
          }
        }
      }
    },
    "setup.classic_step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under Paired Devices, click \"Pair New Device\", or pair from System Settings."
          }
        }
      }
    },
    "setup.classic_step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the device you want to use in the window that appears. Make sure the target device is discoverable by going to the Bluetooth screen on the target device."
          }
        }
      }
    },
    "setup.classic_step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select \"Connect\" to establish a connection. You may need to wait a few seconds before it activates. Occasionally you may want to try again by clicking \"Connect\" a second time if it fails to activate."
          }
        }
      }
    },
    "setup.classic_troubleshooting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the device still does not respond, remove the pairing on both this device and the target device, then pair again."
          }
        }
      }
    },
    "setup.from_app": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect from This Application"
          }
        }
      }
    },
    "setup.from_app_step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap \"Scan\" under Devices."
          }
        }
      }
    },
    "setup.from_app_step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the device to connect. You may identify the device by using the information button."
          }
        }
      }
    },
    "setup.from_device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect from External Device"
          }
        }
      }
    },
    "setup.from_device_step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure advertising is on."
          }
        }
      }
    },
    "setup.from_device_step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the target device, open Bluetooth settings and pair with \"BTRemote\"."
          }
        }
      }
    },
    "setup.from_device_step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure you select \"Pair\" or \"Connect\" on the target device first, then confirm \"Pair\" on this device."
          }
        }
      }
    },
    "setup.guide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guide"
          }
        }
      }
    },
    "setup.le_guide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Bluetooth Low Energy"
          }
        }
      }
    },
    "setup.troubleshooting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If there is no response on the target, forget the pairing on both devices in their respective Settings, and then initiate pairing again from the target device."
          }
        }
      }
    },
